# LifeLens Ω — Environment Variables Template
# Copy this file to .env and fill in your actual values before running.
# Lines starting with # are comments and are ignored.

# ============================================================================
# SERVER
# ============================================================================
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-string-in-production
LIFELENS_HMAC_SALT=change-this-to-a-32-byte-hex-salt-for-salted-hmac-privacy

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://lifelens:password@localhost:5432/lifelens_db

# ============================================================================
# REDIS
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# API SECURITY
# ============================================================================
API_KEY=your-api-key-here

# ============================================================================
# 1. UK Companies House API
# Free registration: https://developer.company-information.service.gov.uk/
# Used for: company legitimacy verification (UK entities)
# ============================================================================
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key_here

# ============================================================================
# 2. US SEC EDGAR
# No key required — just set a descriptive User-Agent as required by SEC policy.
# Format: "CompanyName AdminContact@domain.com"
# Docs: https://www.sec.gov/developer
# ============================================================================
SEC_EDGAR_USER_AGENT=LifeLensOmega admin@lifelens.ai

# ============================================================================
# 3. WHOIS / RDAP Domain Lookup
# Optional — RDAP (https://rdap.org) works as a free fallback.
# Get key: https://www.whoisxmlapi.com/  (free tier: 500 queries/month)
# ============================================================================
WHOIS_API_KEY=your_whoisxml_key_here

# ============================================================================
# 4. PhishTank
# Optional — higher rate-limits with a key. Anonymous still works.
# Get key: https://www.phishtank.com/api_register.php
# ============================================================================
PHISHTANK_API_KEY=your_phishtank_key_here

# ============================================================================
# OPTIONAL: MESSAGING / ALERT INTEGRATIONS
# ============================================================================
# WHATSAPP_TOKEN=
# SLACK_BOT_TOKEN=
