{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🛡️ LifeLens Ω — Executive SRE & API Telemetry",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "API Request Rate (RPS by Method/Status)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(lifelens_requests_total[1m])) by (method, status_code)",
          "legendFormat": "{{method}} {{status_code}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 7, "w": 4, "x": 8, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "auto" },
      "title": "Error Rate (5m Rolling)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(lifelens_request_errors_total[5m])) / sum(rate(lifelens_requests_total[5m]))",
          "legendFormat": "Error Rate"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Request Latency Percentiles (p50 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(lifelens_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(lifelens_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 latency (SLA <= 1.0s)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(lifelens_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "🔍 Verification Intelligence & Risk Assessment",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "title": "Verifications by Risk Level",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum(lifelens_verifications_total) by (risk_level)",
          "legendFormat": "{{risk_level}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0.0 },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 1.0 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "id": 5,
      "options": { "orientation": "horizontal" },
      "title": "Registry Adapter Health Scores",
      "type": "bargauge",
      "targets": [
        {
          "expr": "lifelens_adapter_health",
          "legendFormat": "{{adapter}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "red", "value": 0.90 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 7, "w": 4, "x": 16, "y": 9 },
      "id": 6,
      "options": { "orientation": "auto" },
      "title": "DB Connection Pool Saturation",
      "type": "gauge",
      "targets": [
        {
          "expr": "lifelens_db_pool_usage",
          "legendFormat": "Pool Usage"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 7, "w": 4, "x": 20, "y": 9 },
      "id": 7,
      "options": { "orientation": "auto" },
      "title": "Process Resident Memory",
      "type": "gauge",
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "Resident RAM"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["lifelens", "production", "sre", "observability"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "LifeLens Ω — Production SRE & Observability Dashboard",
  "uid": "lifelens-sre-overview",
  "version": 1
}
